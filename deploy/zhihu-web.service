[Unit]
Description=zhihu workspace
After=network.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/leo-project/zhihu
ExecStart=/home/ubuntu/leo-project/zhihu/.venv/bin/python -m web --port 8777 --public-origin https://d.58nft.net:9455
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
